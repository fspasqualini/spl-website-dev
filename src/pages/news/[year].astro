---
import NewsEntryRow from "../../components/NewsEntryRow.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { archiveYears, entriesByYear } from "../../data/news";
import { withBase } from "../../data/site";

export function getStaticPaths() {
  return archiveYears.map((year) => ({ params: { year } }));
}

const { year } = Astro.params;
const entries = entriesByYear[year!];
---

<BaseLayout
  title={`${year} news | Synthetic Physiology Lab`}
  description={`Synthetic Physiology Lab news from ${year}.`}
>
  <section class="year-page-hero">
    <div class="container">
      <a class="archive-back-link" href={withBase("/news/")}>← All news</a>
      <p class="eyebrow">News archive</p>
      <h1>{year} at SPL</h1>
      <p class="lead">{entries.length} {entries.length === 1 ? "story" : "stories"} documenting our research, people, events, and milestones.</p>
      <p class="year-shortcuts-label">Explore another year</p>
      <nav class="year-shortcuts" aria-label="Explore another archive year">
        {archiveYears.filter((archiveYear) => archiveYear !== year).map((archiveYear) => (
          <a
            href={withBase(`/news/${archiveYear}/`)}
          >{archiveYear}</a>
        ))}
      </nav>
    </div>
  </section>
  <section class="year-page-list">
    <div class="container archive-story-list">
      {entries.map((entry) => <NewsEntryRow entry={entry} showAnchor />)}
    </div>
  </section>
</BaseLayout>
