---
import BaseLayout from "../layouts/BaseLayout.astro";
import { alumni, getImageDimensions, team, withBase } from "../data/site";
---

<BaseLayout
  title="Team | Synthetic Physiology Lab"
  description="Meet the scientists, engineers, artists, and builders behind Synthetic Physiology Lab, a frontier bioengineering group at the University of Pavia."
>
  <section class="section team-current-section">
    <div class="container">
      <p class="eyebrow">Current team</p>
      <h1>Scientists, engineers, artists: come build with us.</h1>
      <p class="lead">Like building for the life sciences, not just studying them? Read our <a href={withBase("/creed/")}>creed</a> and see if this is your kind of work.</p>
      <div class="people-grid">
        {team.map((person) => (
          <article class="person">
            <img
              src={withBase(person.image)}
              alt={`${person.name}, ${person.role} at Synthetic Physiology Lab`}
              width={getImageDimensions(person.image)?.width}
              height={getImageDimensions(person.image)?.height}
              loading="lazy"
              decoding="async"
            />
            <div>
              <h3>{person.name}</h3>
              <p><strong>{person.role}</strong></p>
              <p>{person.focus}</p>
              <a href={`mailto:${person.email}`}>{person.email}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section alumni-section" aria-labelledby="alumni-heading">
    <div class="container">
      <div class="alumni-intro">
        <div>
          <p class="eyebrow">Alumni</p>
          <h2 id="alumni-heading">Built here, carried forward.</h2>
        </div>
        <div>
          <p class="lead">Former members whose work helped shape SPL.</p>
        </div>
      </div>

      <ul class="alumni-prose">
        {alumni.map((person) => (
          <li>
            <span class="alumni-name">{person.name}</span>
            {person.leftYear ? (
              <span class="alumni-year">, {person.leftYear}</span>
            ) : null}
            <span class="alumni-sep"> — </span>
            <span class="alumni-contribution">{person.contribution}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
