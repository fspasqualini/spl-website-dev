---
import BaseLayout from "../layouts/BaseLayout.astro";
import { publicationHighlights, publications } from "../data/site";
import { getPublicationLabels } from "../data/labels";
---

<BaseLayout
  title="Publications | Synthetic Physiology Lab"
  description="Publications from Synthetic Physiology Lab and Francesco S. Pasqualini on bioengineering, engineered cells, tissue systems, mechanobiology, computational modeling, and art-science."
>
  <section class="section">
    <div class="container">
      <div>
        <p class="eyebrow">Research</p>
        <h1>Publications.</h1>
        <p class="lead">SPL publications, newest first, followed by pre-SPL work conducted at the Wyss Institute at Harvard University in Boston.</p>
      </div>
    </div>
  </section>

  <section class="section band-soft" aria-labelledby="highlighted-publications-heading">
    <div class="container split">
      <div>
        <p class="eyebrow">Highlighted papers</p>
        <h2 id="highlighted-publications-heading">A short route into our recent work.</h2>
        <p>Six recent papers spanning instrumented cells, live imaging, engineered tissues, and computational analysis.</p>
      </div>
      <div class="research-paper-list">
        {publicationHighlights.selected.map((paper) => {
          const labels = getPublicationLabels(paper);
          return (
            <a class="research-paper" href={paper.href}>
              <span class="publication-tags">
                <span class="tag" data-category={labels.primary.category} data-label-id={labels.primary.id}>{labels.primary.text}</span>
                <span class="provenance-tag" data-provenance={labels.provenance.id}>{labels.provenance.text}</span>
              </span>
              <strong>{paper.title}</strong>
              <span>{paper.venue} · {paper.year}{paper.doi ? " · DOI " + paper.doi : ""}</span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-heading">
        <p class="eyebrow">Complete record</p>
        <h2>All publications.</h2>
      </div>
      <div class="inventory-list">
        {publications.map((paper) => {
          const labels = getPublicationLabels(paper);
          const detailLabels = labels.primary.id === labels.status.id ? [] : [labels.status.text];
          return (
          <article class="inventory-paper">
            <div class="label-stack">
              <span class="tag" data-category={labels.primary.category} data-label-id={labels.primary.id}>{labels.primary.text}</span>
              <span class="provenance-tag" data-provenance={labels.provenance.id}>{labels.provenance.text}</span>
              {detailLabels.length > 0 && <span class="label-detail">{detailLabels.join(" · ")}</span>}
            </div>
            <div>
              <h2><a href={paper.href}>{paper.title}</a></h2>
              <p>{paper.authors}</p>
              <p><strong>{paper.venue}</strong> · {paper.year}{paper.doi ? " · DOI " + paper.doi : ""}</p>
            </div>
          </article>
        )})}
      </div>
    </div>
  </section>
</BaseLayout>
